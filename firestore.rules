rules_version = '2';
// Deliberately open — this app has no Firebase Auth. Access control is the
// client-side password gating in app/js/auth.js/reports-dashboard.js (a soft
// deterrent, not real security; see CONTEXT.md). Same rule as Pingara's
// vendor-bills project. Shared across every tenant, deployed via
// `firebase deploy --only firestore:rules --project <project>`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
