# Firebase Hosting build output — regenerated by the predeploy step (a mirror
# of app/), never hand-edited, never the source of truth.
public/

# Firebase CLI local state / logs
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.runtimeconfig.json

# Credentials — none should ever live in this repo, but belt and suspenders
*.pem
*.key
serviceAccount*.json
*firebase-adminsdk*.json
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
